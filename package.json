{
  "name": "@natsuneko-laboratory/memora",
  "version": "0.3.0",
  "description": "Memora extracts VRChat, VRCX and ResoniteScreenshotExtensions metadata for Node.js, Browser and React Native.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "react-native": "./dist/react-native.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/react-native.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-react-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.2.0",
    "fflate": "^0.8.2",
    "png-chunks-extract": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/png-chunks-extract": "^1.0.2",
    "esbuild": "^0.28.1",
    "metro": "^0.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}